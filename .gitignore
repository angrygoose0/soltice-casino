[Aa]sset[Bb]undles/
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/**/addressables_content_state.bin
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/**/addressables_content_state.cached
